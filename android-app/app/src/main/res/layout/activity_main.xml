<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        app:liftOnScroll="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:titleTextColor="@android:color/white"
            app:title="@string/app_name" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content area: fills between toolbar and bottom nav -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="56dp">

        <!-- ==================== RECORD PANEL ==================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/panelRecord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- API Key Warning -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardApiWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFF8E1"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="#FFB300"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No API key configured. Add your Claude API key in Settings."
                            android:textColor="#E65100"
                            android:textSize="13sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGoSettings"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Settings"
                            android:textColor="#E65100"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Recording Hero Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="32dp"
                        android:paddingBottom="24dp"
                        android:paddingHorizontal="24dp"
                        android:gravity="center">

                        <!-- Pulse + FAB container -->
                        <FrameLayout
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:gravity="center">

                            <View
                                android:id="@+id/recordingPulse"
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_gravity="center"
                                android:background="@drawable/pulse_ring"
                                android:visibility="gone" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/btnRecord"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:contentDescription="Start Recording"
                                android:src="@drawable/ic_mic"
                                app:fabSize="normal"
                                app:backgroundTint="@color/primary"
                                app:tint="@android:color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvRecordingStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Tap to start recording"
                            android:textSize="15sp"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="00:00"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textColor="@color/on_surface" />

                        <!-- Waveform bars -->
                        <LinearLayout
                            android:id="@+id/waveformContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:visibility="gone">

                            <View android:id="@+id/waveBar1"
                                android:layout_width="6dp" android:layout_height="10dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/wave_bar_bg" />
                            <View android:id="@+id/waveBar2"
                                android:layout_width="6dp" android:layout_height="20dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/wave_bar_bg" />
                            <View android:id="@+id/waveBar3"
                                android:layout_width="6dp" android:layout_height="32dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/wave_bar_bg" />
                            <View android:id="@+id/waveBar4"
                                android:layout_width="6dp" android:layout_height="20dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/wave_bar_bg" />
                            <View android:id="@+id/waveBar5"
                                android:layout_width="6dp" android:layout_height="10dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/wave_bar_bg" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStop"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Stop Recording"
                            android:visibility="gone"
                            app:icon="@drawable/ic_stop"
                            app:strokeColor="@color/error"
                            android:textColor="@color/error" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Captures Hindi &amp; English — generates English MOM"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant"
                            android:gravity="center" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Transcript Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:gravity="center_vertical"
                            android:background="@color/surface_variant">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Live Transcript"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClearTranscript"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Clear"
                                android:textSize="12sp"
                                android:enabled="false" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTranscript"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:padding="12dp"
                            android:clipToPadding="false" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Generate MOM -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressMom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:trackThickness="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerateMom"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Generate MOM Report with AI"
                    android:textSize="16sp"
                    android:enabled="false"
                    app:icon="@drawable/ic_document"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ==================== HISTORY PANEL ==================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/panelHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="80dp"
                    android:gravity="center"
                    android:text="No MOM reports yet.\nRecord a meeting and generate your first MOM!"
                    android:textSize="15sp"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMomHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ==================== TRACKER PANEL ==================== -->
        <LinearLayout
            android:id="@+id/panelTracker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Filter chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPending"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipInProgress"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="In Progress" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDone"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Done" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvEmptyTracker"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="No action items yet.\nGenerate a MOM to track action items here!"
                android:textSize="15sp"
                android:textColor="@color/on_surface_variant"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTracker"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
